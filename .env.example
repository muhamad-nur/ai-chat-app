# Google Gemini API Key from Google AI Studio (Free Tier)
# Get yours for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Recommended Free-Tier Model: gemini-3.5-flash-lite (fastest, lowest-latency free tier)
MODEL_NAME=gemini-3.5-flash-lite

